{
  "name": "yours-truely",
  "version": "0.1.0",
  "description": "Practice interview copilot: hotkey screenshot to spoken-style answers",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.js",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dist": "npm run build && electron-builder --win portable --publish never"
  },
  "build": {
    "appId": "dev.local.yours-truely",
    "productName": "Yours Truely",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "openai": "^7.55.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  }
}
